<script> function freshStore() {   return {     patients: [],     doctors: [       { id:"D001", name:"Dr. Anita Sharma", phone:"9876500001", spec:"Cardiology", fee:500.0 },       { id:"D002", name:"Dr. Vikram Rao",   phone:"9876500002", spec:"Orthopedics", fee:400.0 }     ],     appointments: [],     bills: [],     pC:1, dC:3, aC:1, bC:1   }; } let DB = freshStore(); const pad = (n) => String(n).padStart(3,"0"); const nextP = () => "P" + pad(DB.pC++); const nextD = () => "D" + pad(DB.dC++); const nextA = () => "A" + pad(DB.aC++); const nextB = () => "B" + pad(DB.bC++); const findP = (id) => DB.patients.find(p => p.id.toLowerCase() === (id||"").toLowerCase()); const findD = (id) => DB.doctors.find(d => d.id.toLowerCase() === (id||"").toLowerCase()); let selectedPatientId = null; let selectedDoctorId = null; let selectedApptId = null; function vNotEmpty(v){ return v && v.trim().length>0; } function vPhone(v){ return /^\d{10}$/.test(v||""); } function vDate(v){ return /^\d{2}-\d{2}-\d{4}$/.test(v||""); } function vAge(v){ const n = parseInt(v,10); return !isNaN(n) && n>0 && n<=130; } function vNum(v){ const n = parseFloat(v); return !isNaN(n) && n>=0; } function showDialog(title, msg, icon){   document.getElementById('modalTitle').textContent = title;   document.getElementById('modalMsg').textContent = msg;   document.getElementById('modalIcon').textContent = icon || 'i';   const btns = document.getElementById('modalButtons');   btns.innerHTML = '';   const ok = document.createElement('button');   ok.className = 'btn btn-primary';   ok.textContent = 'OK';   ok.onclick = () => document.getElementById('modalOverlay').style.display = 'none';   btns.appendChild(ok);   document.getElementById('modalOverlay').style.display = 'flex'; } function showConfirm(title, msg, onYes){
  document.getElementById('modalTitle').textContent = title;   document.getElementById('modalMsg').textContent = msg;   document.getElementById('modalIcon').textContent = '?';   const btns = document.getElementById('modalButtons');   btns.innerHTML = '';
  const yes = document.createElement('button');   yes.className = 'btn btn-primary'; yes.textContent = 'Yes';
  yes.onclick = () => { document.getElementById('modalOverlay').style.display='none'; onYes(); };   const no = document.createElement('button');   no.className = 'btn'; no.textContent = 'No';
  no.onclick = () => document.getElementById('modalOverlay').style.display='none';   btns.appendChild(yes); btns.appendChild(no);
  document.getElementById('modalOverlay').style.display = 'flex'; } function doLogin(){   const u = document.getElementById('loginUser').value.trim();   const p = document.getElementById('loginPass').value.trim();   const err = document.getElementById('loginErr');
  if(!u || !p){ err.textContent = ">> Cannot be empty."; return; }   if(u === "admin" && p === "admin123"){     err.textContent = "";     document.getElementById('loginScreen').style.display = 'none';     document.getElementById('mainApp').style.display = 'block';     showScreen('dash');     renderPatients(); renderDoctors(DB.doctors); renderAppointments();     populateApptCombos(); populateBillPatientCombo();     return;   }   err.textContent = ">> Invalid credentials. Try again."; } function showScreen(name){   ['dash','patient','doctor','appt','bill'].forEach(s => {     document.getElementById('screen-'+s).hidden = (s !== name);     const tab = document.getElementById('tab-'+s);     if(tab) tab.classList.toggle('active', s === name);   });
  if(name === 'appt') populateApptCombos();   if(name === 'bill') populateBillPatientCombo(); } function renderPatients(){   const t = document.getElementById('patientTable');   let html = '<tr><th>ID</th><th>Name</th><th>Age</th><th>Gender</th><th>Phone</th><th>Address</th>     <th>Disease</th></tr>';   if(DB.patients.length === 0){     html += '<tr class="empty-row"><td colspan="7">(No patients yet.)</td></tr>';   } else {     DB.patients.forEach(p => {
      html += `<tr class="datarow ${p.id===selectedPatientId?'selected':''}" onclick="selectPatient     Row('${p.id}')">
        <td>${p.id}</td><td>${p.name}</td><td>${p.age}</td><td>${p.gender}</td>         <td>${p.phone}</td><td>${p.address}</td><td>${p.disease}</td></tr>`;
    });   }
  t.innerHTML = html; } function selectPatientRow(id){   selectedPatientId = id;   const p = findP(id);   if(p){
    document.getElementById('pat_id').value = p.id;     document.getElementById('pat_id_disp').value = p.id;     document.getElementById('pat_name').value = p.name;     document.getElementById('pat_age').value = p.age;     document.getElementById('pat_gender').value = p.gender;     document.getElementById('pat_phone').value = p.phone;     document.getElementById('pat_address').value = p.address;     document.getElementById('pat_disease').value = p.disease;   }
  renderPatients(); }
function clearPatientForm(){   selectedPatientId = null;   document.getElementById('pat_id').value = '';   document.getElementById('pat_id_disp').value = '(auto)';   ['pat_name','pat_age','pat_phone','pat_address','pat_disease'].forEach(id => document.getElementB     yId(id).value='');   document.getElementById('pat_gender').value = 'Male';   document.getElementById('pat_err').textContent = '';   renderPatients();
} function registerPatient(){   const name = document.getElementById('pat_name').value.trim();   const age = document.getElementById('pat_age').value.trim();   const gender = document.getElementById('pat_gender').value;   const phone = document.getElementById('pat_phone').value.trim();   const address = document.getElementById('pat_address').value.trim();   const disease = document.getElementById('pat_disease').value.trim();   const err = document.getElementById('pat_err');   if(!vNotEmpty(name)) return err.textContent = 'Error: Name cannot be empty.';   if(!vAge(age)) return err.textContent = 'Error: Age must be valid (1-130).';   if(!vNotEmpty(gender)) return err.textContent = 'Error: Gender cannot be empty.';   if(!vPhone(phone)) return err.textContent = 'Error: Phone must be 10 digits.';   if(!vNotEmpty(address)) return err.textContent = 'Error: Address cannot be empty.';   if(!vNotEmpty(disease)) return err.textContent = 'Error: Disease cannot be empty.';   err.textContent = '';
  const p = { id: nextP(), name, age: parseInt(age,10), gender, phone, address, disease };   DB.patients.push(p);   clearPatientForm();   showDialog('Success', 'Patient registered: ' + p.id + ' - ' + p.name, 'ok');   populateApptCombos(); populateBillPatientCombo(); } function updatePatient(){   const err = document.getElementById('pat_err');   if(!selectedPatientId) return err.textContent = 'Error: Select a patient row first.';   const p = findP(selectedPatientId);   const name = document.getElementById('pat_name').value.trim();   const age = document.getElementById('pat_age').value.trim();   const phone = document.getElementById('pat_phone').value.trim();   const disease = document.getElementById('pat_disease').value.trim();   if(!vNotEmpty(name)) return err.textContent = 'Error: Name cannot be empty.';   if(!vAge(age)) return err.textContent = 'Error: Age must be valid (1-130).';   if(!vPhone(phone)) return err.textContent = 'Error: Phone must be 10 digits.';   if(!vNotEmpty(disease)) return err.textContent = 'Error: Disease cannot be empty.';   err.textContent = '';
  p.name = name; p.age = parseInt(age,10); p.phone = phone;
  p.gender = document.getElementById('pat_gender').value;
  p.address = document.getElementById('pat_address').value.trim();
  p.disease = disease;   renderPatients();   showDialog('Updated', '>> Patient updated.', 'ok'); } function deletePatient(){
  const err = document.getElementById('pat_err');   if(!selectedPatientId) return err.textContent = 'Error: Select a patient row first.';   const p = findP(selectedPatientId);
  showConfirm('Confirm Delete', 'Delete ' + p.name + '?', () => {     DB.patients = DB.patients.filter(x => x.id !== p.id);     clearPatientForm();     populateApptCombos(); populateBillPatientCombo();   }); }
function renderDoctors(list){
  const t = document.getElementById('doctorTable');   let html = '<tr><th>ID</th><th>Name</th><th>Specialization</th><th>Fee</th><th>Contact</th></tr>'     ;
  if(list.length === 0){     html += '<tr class="empty-row"><td colspan="5">(No doctors found.)</td></tr>';   } else {     list.forEach(d => {       html += `<tr class="datarow ${d.id===selectedDoctorId?'selected':''}" onclick="selectDoctorRo     w('${d.id}')">         <td>${d.id}</td><td>${d.name}</td><td>${d.spec}</td><td>${d.fee.toFixed(1)}</td><td>${d.pho     ne}</td></tr>`;     });   }
  t.innerHTML = html; } function selectDoctorRow(id){   selectedDoctorId = id;   const d = findD(id);   if(d){     document.getElementById('doc_id').value = d.id;     document.getElementById('doc_id_disp').value = d.id;     document.getElementById('doc_name').value = d.name;     document.getElementById('doc_spec').value = d.spec; document.getElementById('doc_fee').value = d.fee;     document.getElementById('doc_phone').value = d.phone;   }
  renderDoctors(DB.doctors); } function clearDoctorForm(){   selectedDoctorId = null;   document.getElementById('doc_id').value = '';   document.getElementById('doc_id_disp').value = '(auto)';   ['doc_name','doc_spec','doc_fee','doc_phone'].forEach(id => document.getElementById(id).value='')     ;   document.getElementById('doc_err').textContent = '';   renderDoctors(DB.doctors); } function addDoctor(){   const name = document.getElementById('doc_name').value.trim();   const spec = document.getElementById('doc_spec').value.trim();   const fee = document.getElementById('doc_fee').value.trim();   const phone = document.getElementById('doc_phone').value.trim();   const err = document.getElementById('doc_err');   if(!vNotEmpty(name)) return err.textContent = 'Error: Name cannot be empty.';   if(!vNotEmpty(spec)) return err.textContent = 'Error: Specialization cannot be empty.';   if(!vNum(fee)) return err.textContent = 'Error: Fee must be a valid non-negative number.';   if(!vPhone(phone)) return err.textContent = 'Error: Contact must be 10 digits.';   err.textContent = '';
  const d = { id: nextD(), name, spec, fee: parseFloat(fee), phone };   DB.doctors.push(d);   clearDoctorForm();
  showDialog('Success', 'Doctor added: ' + d.id + ' - ' + d.name, 'ok');   populateApptCombos(); }
function updateDoctor(){
  const err = document.getElementById('doc_err');
  if(!selectedDoctorId) return err.textContent = 'Error: Select a doctor row first.';   const d = findD(selectedDoctorId);
  const fee = document.getElementById('doc_fee').value.trim();   const phone = document.getElementById('doc_phone').value.trim();
  if(!vNum(fee)) return err.textContent = 'Error: Fee must be a valid non-negative number.';   if(!vPhone(phone)) return err.textContent = 'Error: Contact must be 10 digits.';   err.textContent = '';
  d.fee = parseFloat(fee); d.phone = phone;
  d.name = document.getElementById('doc_name').value.trim();
  d.spec = document.getElementById('doc_spec').value.trim();   renderDoctors(DB.doctors);   showDialog('Updated', '>> Doctor updated.', 'ok');
}
function deleteDoctor(){   const err = document.getElementById('doc_err');   if(!selectedDoctorId) return err.textContent = 'Error: Select a doctor row first.';   const d = findD(selectedDoctorId);
  showConfirm('Confirm Delete', 'Delete ' + d.name + '?', () => {     DB.doctors = DB.doctors.filter(x => x.id !== d.id);     clearDoctorForm();     populateApptCombos();   }); } function searchDoctor(){   const kw = document.getElementById('doc_search').value.trim().toLowerCase();   renderDoctors(DB.doctors.filter(d => d.name.toLowerCase().includes(kw))); } function populateApptCombos(){   const ps = document.getElementById('appt_patient');   const ds = document.getElementById('appt_doctor');   ps.innerHTML = DB.patients.length     ? DB.patients.map(p => `<option value="${p.id}">${p.id} - ${p.name}</option>`).join('')     : '<option value="">(no patients)</option>';   ds.innerHTML = DB.doctors.length     ? DB.doctors.map(d => `<option value="${d.id}">${d.id} - ${d.name}</option>`).join('')
    : '<option value="">(no doctors)</option>'; } function renderAppointments(){   const t = document.getElementById('apptTable');   let html = '<tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</t     h></tr>';   if(DB.appointments.length === 0){     html += '<tr class="empty-row"><td colspan="6">(No appointments yet.)</td></tr>';   } else {     DB.appointments.forEach(a => {       html += `<tr class="datarow ${a.id===selectedApptId?'selected':''}" onclick="selectApptRow('$     {a.id}')">
        <td>${a.id}</td><td>${a.patient.name}</td><td>${a.doctor.name}</td>         <td>${a.date}</td><td>${a.time}</td><td>${a.status}</td></tr>`;
    });   }
  t.innerHTML = html; } function selectApptRow(id){ selectedApptId = id; renderAppointments(); } function bookAppointment(){   const err = document.getElementById('appt_err');
  if(DB.patients.length === 0) return err.textContent = 'Error: Register a patient first.';   if(DB.doctors.length === 0) return err.textContent = 'Error: No doctors available.';   const pid = document.getElementById('appt_patient').value;   const did = document.getElementById('appt_doctor').value;   const date = document.getElementById('appt_date').value.trim();   const time = document.getElementById('appt_time').value.trim();   const p = findP(pid), d = findD(did);
  if(!p) return err.textContent = 'Error: Invalid Patient.';   if(!d) return err.textContent = 'Error: Invalid Doctor.';
  if(!vDate(date)) return err.textContent = 'Error: Date must be dd-mm-yyyy.';   if(!vNotEmpty(time)) return err.textContent = 'Error: Time cannot be empty.';   err.textContent = '';
  const a = { id: nextA(), patient:p, doctor:d, date, time, status:'Booked' };   DB.appointments.push(a);   document.getElementById('appt_date').value = '';   document.getElementById('appt_time').value = '';   renderAppointments();   showDialog('Booked', '>> Appointment booked: ' + a.id, 'ok');
} function cancelAppointment(){   const err = document.getElementById('appt_err');   if(!selectedApptId) return err.textContent = 'Error: Select an appointment row first.';   const a = DB.appointments.find(x => x.id === selectedApptId);   if(!a) return err.textContent = 'Error: Not found.';   err.textContent = '';
  a.status = 'Cancelled';   renderAppointments();   showDialog('Cancelled', '>> Appointment ' + a.id + ' cancelled.', 'i'); } function populateBillPatientCombo(){   const s = document.getElementById('bill_patient');
  s.innerHTML = DB.patients.length     ? DB.patients.map(p => `<option value="${p.id}">${p.id} - ${p.name}</option>`).join('')
    : '<option value="">(no patients)</option>'; } function generateBill(){
  const err = document.getElementById('bill_err');   if(DB.patients.length === 0) return err.textContent = 'Error: Register a patient first.';   const pid = document.getElementById('bill_patient').value;   const p = findP(pid);   if(!p) return err.textContent = 'Error: Invalid Patient.';   const docFee = document.getElementById('bill_doc').value.trim();   const medFee = document.getElementById('bill_med').value.trim();   const roomFee = document.getElementById('bill_room').value.trim();   const labFee = document.getElementById('bill_lab').value.trim();   if(!vNum(docFee)) return err.textContent = 'Error: Doctor Fee must be a valid number.';   if(!vNum(medFee)) return err.textContent = 'Error: Medicine Charge must be a valid number.';   if(!vNum(roomFee)) return err.textContent = 'Error: Room Charge must be a valid number.';   if(!vNum(labFee)) return err.textContent = 'Error: Lab Charge must be a valid number.';   err.textContent = '';   const df = parseFloat(docFee), mf = parseFloat(medFee), rf = parseFloat(roomFee), lf = parseFloat     (labFee);   const total = df + mf + rf + lf;
  const bill = { id: nextB(), patient:p, docFee:df, medFee:mf, roomFee:rf, labFee:lf, total };   DB.bills.push(bill);   const r = "=========================================\n"     + "           HOSPITAL BILL RECEIPT\n"
    + "=========================================\n"
    + "Bill ID       : " + bill.id + "\n"
    + "Patient Name  : " + p.name + "\n"
    + "-----------------------------------------\n"
    + "Doctor Fee    : Rs. " + df.toFixed(2) + "\n"
    + "Medicine Charge: Rs. " + mf.toFixed(2) + "\n"
    + "Room Charge   : Rs. " + rf.toFixed(2) + "\n"
    + "Lab Charge    : Rs. " + lf.toFixed(2) + "\n"
    + "-----------------------------------------\n"
    + "TOTAL         : Rs. " + total.toFixed(2) + "\n"
    + "=========================================\n"     + "        Thank you for choosing us!";
  document.getElementById('billReceipt').textContent = r;
  showDialog('Bill Generated', 'Total: Rs. ' + total.toFixed(2), 'bill'); } function confirmExit(){
  showConfirm('Exit', 'Exit the application?', () => {     document.getElementById('mainApp').style.display = 'none';     document.getElementById('closedScreen').style.display = 'flex';     document.getElementById('closedScreen').style.minHeight = '100vh';   });
}
function restartApp(){   DB = freshStore();   selectedPatientId = null; selectedDoctorId = null; selectedApptId = null;   document.getElementById('loginUser').value = '';   document.getElementById('loginPass').value = '';   document.getElementById('loginErr').textContent = '';   document.getElementById('closedScreen').style.display = 'none';   document.getElementById('loginScreen').style.display = 'flex'; }
